GCS_BUCKET_NAME=audio_test_112

# Google Gemini 官方 API（设置后优先使用，替代 EvoLink）
GOOGLE_API_KEY=                   # Google AI Studio API Key（https://aistudio.google.com/app/apikey）

# TikTok 第三方 API 配置
TIKWM_API_KEY=                    # 可选，tikwm.com API key
RAPIDAPI_KEY=your_rapidapi_key    # RapidAPI key，用于 tiktok-api23 fallback
APIFY_TOKEN=

# Open API 配置（视频发布服务）
OPEN_API_BASE_URL=http://192.168.199.28:8080
OPEN_API_CLIENT_ID=default_client
OPEN_API_CLIENT_SECRET=xxxxx
# OPEN_API_CALLBACK_URL=http://your-domain.com/api/v1/open-api/callback/publication  # 可选，用于接收发布回调

# 外部发布 API（独立维护的第三方频道发布服务）
EXT_PUB_API_BASE_URL=http://34.21.25.209:8000
# X-API-Key 认证密钥
EXT_PUB_API_KEY=

